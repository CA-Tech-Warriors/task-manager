                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const task = pm.response.json().find((t) => t.id === Number(pm.collectionVariables.get('adminTaskId')));",
                  "pm.test(\"shows the owner's username\", () => pm.expect(task.owner).to.eql(`${pm.collectionVariables.get('runUsername')}-new`));"
                ]
              }
            }
          ]
