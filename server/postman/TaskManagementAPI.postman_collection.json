            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{runUsername}}\",\n  \"email\": \"{{runEmail}}\",\n  \"password\": \"{{runPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('runUsername', `user${suffix}`);",
                  "pm.collectionVariables.set('runEmail', `user${suffix}@example.com`);",
                  "pm.collectionVariables.set('runPassword', 'Password123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const responseJson = pm.response.json();",
                  "if (responseJson && responseJson.token) {",
                  "  pm.collectionVariables.set('authToken', responseJson.token);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
