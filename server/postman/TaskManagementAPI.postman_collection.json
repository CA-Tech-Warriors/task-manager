    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{runUsername}}\",\n  \"email\": \"{{runEmail}}\",\n  \"password\": \"{{runPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh user for every run, so the collection can run again and again.",
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('runUsername', `pm${suffix}`);",
                  "pm.collectionVariables.set('runEmail', `pm${suffix}@example.com`);",
                  "pm.collectionVariables.set('runPassword', 'Password123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns a token and the user', () => { pm.expect(body.token).to.be.a('string'); pm.expect(body.user.id).to.be.a('number'); });",
                  "pm.test('never returns the password hash', () => pm.expect(body.user).to.not.have.property('passwordHash'));",
                  "pm.collectionVariables.set('authToken', body.token);",
                  "pm.collectionVariables.set('runUserId', body.user.id);"
                ]
              }
            }
          ]
        },
