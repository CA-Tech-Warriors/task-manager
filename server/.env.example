# Copy to .env and fill in. Never commit .env.
PORT=3001
NODE_ENV=development

# Required in production. Locally, leave empty to run without a database
# (routes that need the database will return 503 until it's connected).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_management
POSTGRES_SSL=false

# Required in production. Use a long random string.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=7d

# The frontend's URL, for CORS.
CLIENT_URL=http://localhost:5173

# bcrypt cost. The rubric needs 10 or more.
BCRYPT_ROUNDS=12
